{
  "name": "sallys-escape",
  "version": "1.0.0",
  "private": true,
  "description": "Sally's Escape: standalone exploration and stealth adventure",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.cjs",
    "prepare:static": "node scripts/prepare-static.cjs",
    "test": "node --test tests/*.cjs",
    "level:lab": "node scripts/level-lab.cjs",
    "level:benchmark": "node scripts/level-benchmark.cjs",
    "level:practice": "node scripts/level-practice.cjs",
    "level:smoke": "node scripts/level-benchmark.cjs --only quiet-vault,leafy-crossroads,fern-cloister --width 2 --budget 200 --milliseconds 10000 --trials 0 --out work/smoke"
  },
  "devDependencies": {
    "p5": "1.11.2",
    "tone": "15.0.4"
  }
}

